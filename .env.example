# =============================================================================
# Hefesto Studio — Kit Langfuse · Plantilla de variables de entorno
#
#   NO EDITES ESTE ARCHIVO. Copialo y edita la copia:
#
#       cp .env.example .env
#       chmod 600 .env
#
# El archivo `.env` esta en .gitignore y NUNCA debe subirse a un repositorio.
#
# -----------------------------------------------------------------------------
# COMO GENERAR LOS SECRETOS (necesitas `openssl`, viene en Ubuntu/Debian)
# -----------------------------------------------------------------------------
#   SALT               -> openssl rand -hex 32
#   ENCRYPTION_KEY     -> openssl rand -hex 32      (exactamente 64 hex)
#   NEXTAUTH_SECRET    -> openssl rand -base64 32
#   CLICKHOUSE_PASSWORD -> openssl rand -base64 24
#   POSTGRES_PASSWORD  -> openssl rand -base64 24
#   REDIS_AUTH         -> openssl rand -base64 24
#   MINIO_ROOT_PASSWORD-> openssl rand -base64 24
#   LANGFUSE_INIT_USER_PASSWORD -> openssl rand -base64 24
#
# -----------------------------------------------------------------------------
# ADVERTENCIAS QUE IMPORTAN
# -----------------------------------------------------------------------------
# * SALT y ENCRYPTION_KEY derivan material criptografico. Si se pierden, las
#   claves de API existentes dejan de validar y hay que CREAR LAS DE NUEVO.
#   Si se cambian, pasa lo mismo. No se pueden recuperar. Guardalos aparte,
#   en un gestor de secretos, hoy, antes de instalar.
# * Este archivo contiene SOLO valores de ejemplo claramente falsos.
# =============================================================================


# -----------------------------------------------------------------------------
# 0. Nombre del proyecto Docker Compose (solo Docker directo)
# -----------------------------------------------------------------------------
# Fija el nombre del proyecto para que los volumenes se sigan llamando
# `langfuse_langfuse_*` como antes. Sin esto, una instalacion existente que
# ejecute `docker compose up -d` arranca con volumenes nuevos vacios y
# parece que se perdieron los datos.
#
# Solo aplica a Docker directo. En Coolify NO definir esta variable: el
# proxy del despliegue pone su propio nombre de proyecto.
COMPOSE_PROJECT_NAME=langfuse


# -----------------------------------------------------------------------------
# 1. Identidad publica de la instancia
# -----------------------------------------------------------------------------
# URL con la que el usuario accede finalmente a Langfuse, con esquema y sin barra
# final. Debe coincidir exactamente con el dominio real: Langfuse la usa para
# construir enlaces y para el flujo de inicio de sesion.
# En desarrollo puede quedar como http://localhost:3000.
# OBLIGATORIA
NEXTAUTH_URL=https://observabilidad.ejemplo.cl

# Firma las cookies de sesion.
# OBLIGATORIA
NEXTAUTH_SECRET=CAMBIAR-ejemplo-base64-falso-no-usar-en-produccion

# Numero de proxies inversos confiables que hay delante de la aplicacion.
# 0 = la peticion llega directa (desarrollo). 1 = hay un proxy (produccion
# comun: Traefik de Coolify, Caddy, nginx). Es lo que permite que Langfuse
# lea correctamente la IP real del cliente y el protocolo.
# OBLIGATORIA en produccion
LANGFUSE_TRUSTED_PROXY_COUNT=1


# -----------------------------------------------------------------------------
# 2. Cierre del registro de usuarios
# -----------------------------------------------------------------------------
# true = NADIE puede crear una cuenta nueva. Solo entran los usuarios que ya
# existen. Es la variable que realmente cierra el registro en la edicion libre.
# Ponla en `true` ANTES de publicar la instancia en internet.
# OBLIGATORIA en produccion
AUTH_DISABLE_SIGNUP=true

# NO es lo mismo que lo anterior. Esta solo omite el paso del formulario de
# novedades durante el registro; no impide crear cuentas.
LANGFUSE_DISABLE_SIGNUP_ONBOARDING=true


# -----------------------------------------------------------------------------
# 3. PostgreSQL — estado de la aplicacion
# -----------------------------------------------------------------------------
# Este bloque guarda lo IRREEMPLAZABLE del kit: usuarios, organizaciones,
# proyectos, MEMBRESIAS y CLAVES DE API. Ver docs/05-RESPALDOS-Y-RESTAURACION.md
POSTGRES_USER=langfuse
# OBLIGATORIA
POSTGRES_PASSWORD=CAMBIAR-ejemplo-contrasena-falsa-no-usar
POSTGRES_DB=langfuse


# -----------------------------------------------------------------------------
# 4. Secretos criptograficos de la aplicacion
# -----------------------------------------------------------------------------
# NO CAMBIAR NUNCA despues de la primera instalacion.
# Derivan el material con el que se validan las claves de API del proyecto.
# OBLIGATORIA
SALT=CAMBIAR-ejemplo-salt-falso-no-usar

# Exactamente 64 caracteres hexadecimales. NO CAMBIAR NUNCA.
# OBLIGATORIA
ENCRYPTION_KEY=CAMBIAR-clave-falsa-de-64-caracteres-hexadecimales-no-usar-000000000000


# -----------------------------------------------------------------------------
# 5. ClickHouse — almacen de eventos (trazas, observaciones, puntuaciones)
# -----------------------------------------------------------------------------
# Almacen DISTINTO del de la aplicacion y obligatorio: Langfuse autoalojado
# no funciona sin ClickHouse.
CLICKHOUSE_USER=langfuse
# OBLIGATORIA
CLICKHOUSE_PASSWORD=CAMBIAR-ejemplo-contrasena-falsa-no-usar
CLICKHOUSE_DB=default
CLICKHOUSE_CLUSTER_ENABLED=false
CLICKHOUSE_CLUSTER_NAME=default


# -----------------------------------------------------------------------------
# 6. Redis — cola de trabajos y cache (regenerable)
# -----------------------------------------------------------------------------
# OBLIGATORIA
REDIS_AUTH=CAMBIAR-ejemplo-contrasena-falsa-no-usar
REDIS_TLS_ENABLED=false


# -----------------------------------------------------------------------------
# 7. MinIO — almacen de objetos S3 (medios y eventos crudos)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=langfuse
# OBLIGATORIA
MINIO_ROOT_PASSWORD=CAMBIAR-ejemplo-contrasena-falsa-no-usar

# Credenciales que usa la aplicacion dentro de la red Docker. Puede ser un
# usuario dedicado en vez del root; por simplicidad este kit usa el mismo par.
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
# OBLIGATORIA
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CAMBIAR-ejemplo-contrasena-falsa-no-usar
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
# OBLIGATORIA
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CAMBIAR-ejemplo-contrasena-falsa-no-usar

# Endpoint interno: lo usa el contenedor web para escribir. No cambiar.
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000

# Endpoint que ve el NAVEGADOR del usuario final, en las URL firmadas de los
# medios. En una instalacion real debe ser alcanzable desde el computador del
# cliente. Si no lo es, las imagenes y adjuntos no cargan en la interfaz.
# Ver README.md, seccion "Medios y MinIO", antes de fijar este valor.
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=https://observabilidad.ejemplo.cl


# -----------------------------------------------------------------------------
# 8. Inicializacion sin interfaz (opcional, solo la PRIMERA vez)
# -----------------------------------------------------------------------------
# Permite crear organizacion, proyecto y usuario inicial por variables, util
# para despliegues automaticos. Tras el primer arranque estas variables se
# pueden vaciar y reiniciar: no se vuelven a aplicar.
#
# Si las dejas vacias, se crea la cuenta a mano siguiendo
# docs/04-PRIMERA-CUENTA-Y-USUARIOS.md (camino recomendado para Hefesto).
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
# Public key y secret key del proyecto inicial, si se fijan aqui.
# OJO: son credenciales. El secret key que se ponga en este archivo queda en
# el historial de despliegue. Hefesto prefiere crearlas desde la interfaz.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
# OBLIGATORIA solo si se usan las variables de inicializacion
LANGFUSE_INIT_USER_PASSWORD=
# Dias de retencion del proyecto inicial. En la edicion libre esta funcion
# es de pago (Enterprise): ver docs/08-SERVICIOS-COMERCIALES.md
LANGFUSE_INIT_PROJECT_RETENTION=


# -----------------------------------------------------------------------------
# 9. Correo (opcional)
# -----------------------------------------------------------------------------
# Sin esto, el enlace "olvide mi contrasena" NO funciona y la recuperacion de
# clave se hace a mano en la base de datos.
EMAIL_FROM_ADDRESS=
SMTP_CONNECTION_URL=


# -----------------------------------------------------------------------------
# 10. Ajustes varios
# -----------------------------------------------------------------------------
# Hefesto deja la telemetria apagada por defecto. Se puede activar.
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
LANGFUSE_OBSERVATION_FIELD_OVERFLOW_ENABLED=false
LANGFUSE_OBSERVATION_FIELD_SIZE_LIMIT_BYTES=2097152
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false


# -----------------------------------------------------------------------------
# 11. Red: listas de control de salida
# -----------------------------------------------------------------------------
# Vacias = la politica de salida queda sin cambios (cualquier destino
# permitido). Se pueden restringir para limitar por donde salen los datos.
# Ver docs/10-LICENCIAS-Y-FUENTES.md y la documentacion de seguridad de
# upstream antes de restringirlos.
LANGFUSE_LLM_CONNECTION_WHITELISTED_HOST=
LANGFUSE_LLM_CONNECTION_WHITELISTED_IPS=
LANGFUSE_LLM_CONNECTION_WHITELISTED_IP_SEGMENTS=
LANGFUSE_LLM_CONNECTION_ALLOWED_HOSTS=
LANGFUSE_WEBHOOK_ALLOWED_HOSTS=
LANGFUSE_EXTERNAL_MEDIA_STORAGE_ENDPOINT_ALLOWED_HOSTS=
LANGFUSE_OUTBOUND_BLOCKED_IP_SEGMENTS=